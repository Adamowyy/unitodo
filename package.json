{
  "name": "unitodo",
  "version": "2.0.0",
  "description": "Multi-user task and note manager: project groups, a kanban board with subtasks, and notes with comments.",
  "license": "MIT",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "vercel dev",
    "deploy": "vercel --prod --yes",
    "migrate": "node db/migrate.js",
    "test": "node --test",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "todo",
    "kanban",
    "notes",
    "express",
    "postgresql",
    "ejs",
    "electron"
  ],
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.unitodo.app",
    "productName": "UniTodo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  }
}
