# PostgreSQL connection string. Neon gives you both, the unpooled one is used by the app
# and by the migrations, the pooled one is a fallback.
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signs the session tokens. Required in production, a development value is used locally.
JWT_SECRET=change-me

# Comma separated user ids that get the admin panel.
ADMIN_USER_IDS=

# Local development only, defaults to 3000.
PORT=3000
