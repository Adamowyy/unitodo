<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-200">Moje grupy</h1>
  <div class="flex gap-2">
    <button onclick="openJoinModal()" class="text-sm text-blue-600 dark:text-blue-400 border border-blue-300 dark:border-blue-700 px-3 py-2 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/30 transition">
      🔗 Dołącz do grupy
    </button>
    <button onclick="openModal('groupModal')" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm font-medium">
      + Nowa grupa
    </button>
  </div>
</div>

<!-- Dołącz do grupy modal -->
<div id="joinModal" class="modal-overlay">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold">Dołącz do grupy</h3>
      <button onclick="closeModal('joinModal')" class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400">&times;</button>
    </div>
    <form onsubmit="joinGroup(event)" class="flex gap-2">
      <input type="text" id="inviteCodeInput" placeholder="Wklej kod zaproszenia..."
        class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200 text-sm">
      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">Dołącz</button>
    </form>
  </div>
</div>

<script>
function openJoinModal() {
  document.getElementById('joinModal').classList.add('active');
  document.getElementById('inviteCodeInput').focus();
}
function joinGroup(e) {
  e.preventDefault();
  const code = document.getElementById('inviteCodeInput').value.trim();
  if (code) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/groups/join/' + code;
    document.body.appendChild(form);
    form.submit();
  }
}
</script>

<% const catKeys = Object.keys(categories).sort(); %>
<% if (catKeys.length === 0) { %>
  <div class="text-center py-16 text-gray-400 dark:text-gray-500">
    <div class="text-6xl mb-4">📂</div>
    <p class="text-lg">Brak grup projektów</p>
    <p class="text-sm mt-2">Kliknij "Nowa grupa", aby rozpocząć</p>
  </div>
<% } else { %>
  <% catKeys.forEach((cat, catIdx) => { 
    const catGroups = categories[cat];
    const catId = 'cat-' + catIdx;
  %>
    <!-- Category section -->
    <div class="mb-6 category-section" data-category="<%= cat %>">
      <div class="flex items-center gap-2 mb-3 select-none"
           draggable="true"
           ondragstart="onCategoryDragStart(event)"
           ondragover="onCategoryDragOver(event)"
           ondragleave="onCategoryDragLeave(event)"
           ondrop="onCategoryDrop(event)"
           onclick="toggleCategory('<%= catId %>')"
           style="cursor:grab">
        <span class="text-gray-300 dark:text-gray-600 text-xs cursor-grab">⠿</span>
        <span id="<%= catId %>-arrow" class="text-xs text-gray-400 transition-transform inline-block">▼</span>
        <h2 class="text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide"><%= cat %></h2>
        <span class="text-xs text-gray-400">(<%= catGroups.length %>)</span>
      </div>
      <div id="<%= catId %>" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% catGroups.forEach(group => { %>
          <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow dark:bg-gray-800 dark:border-gray-700 dark:hover:shadow-gray-900/30 flex flex-col">
            <div class="flex justify-between items-start">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <% if ((group.member_count || 1) > 1) { %>
                    <span class="text-xs text-gray-400 dark:text-gray-500 shrink-0">👥 <%= group.member_count %></span>
                  <% } %>
                  <h2 class="font-semibold text-gray-800 text-lg truncate dark:text-gray-200"><%= group.name %></h2>
                </div>
                <% if (group.description) { %>
                  <p class="text-gray-500 text-sm mt-1 truncate dark:text-gray-400"><%= group.description %></p>
                <% } %>
              </div>
              <div class="flex gap-1 ml-2 shrink-0">
                <% if (group.role === 'owner') { %>
                <button onclick="event.stopPropagation(); editGroup(<%= group.id %>, '<%= group.name.replace(/'/g, "\\'") %>', '<%= (group.description || '').replace(/'/g, "\\'") %>', '<%= (group.category || '').replace(/'/g, "\\'") %>')" class="text-gray-400 hover:text-blue-600 p-1 dark:text-gray-500 dark:hover:text-blue-400" title="Edytuj">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </button>
                <form method="POST" action="/groups/<%= group.id %>?_method=DELETE" data-confirm="Usunąć grupę wraz ze wszystkimi danymi?" class="inline">
                  <input type="hidden" name="_method" value="DELETE">
                  <button type="submit" class="text-gray-400 hover:text-red-600 p-1 dark:text-gray-500" title="Usuń">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  </button>
                </form>
                <% } else { %>
                <form method="POST" action="/groups/<%= group.id %>/leave" data-confirm="Opuścić tę grupę?" class="inline">
                  <button type="submit" class="text-gray-400 hover:text-orange-500 p-1 dark:text-gray-500 dark:hover:text-orange-400" title="Opuść grupę">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                  </button>
                </form>
                <% } %>
              </div>
            </div>
            <div class="mt-auto pt-3 flex gap-2">
              <a href="/groups/<%= group.id %>/notes" class="flex-1 text-center text-sm bg-gray-50 hover:bg-blue-50 text-gray-600 hover:text-blue-700 py-2 rounded-lg border border-gray-200 transition dark:bg-gray-900 dark:hover:bg-blue-900/30 dark:text-gray-300 dark:hover:text-blue-400 dark:border-gray-700">
                📝 Notatki
              </a>
              <a href="/groups/<%= group.id %>/tasks" class="flex-1 text-center text-sm bg-gray-50 hover:bg-blue-50 text-gray-600 hover:text-blue-700 py-2 rounded-lg border border-gray-200 transition dark:bg-gray-900 dark:hover:bg-blue-900/30 dark:text-gray-300 dark:hover:text-blue-400 dark:border-gray-700">
                ✅ Zadania
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
<% } %>

<!-- Modal dodawania/edycji grupy -->
<div id="groupModal" class="modal-overlay">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold" id="groupModalTitle">Nowa grupa</h3>
      <button onclick="closeModal('groupModal')" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300">&times;</button>
    </div>
    <form id="groupForm" method="POST" action="/groups">
      <input type="hidden" name="_method" id="groupMethod" value="POST">
      <input type="hidden" name="id" id="groupId">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300">Nazwa grupy</label>
        <input type="text" name="name" id="groupName" required
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:focus:ring-blue-400 dark:focus:border-blue-400">
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300">Kategoria</label>
        <input type="text" name="category" id="groupCategory" placeholder="np. Praca, Studia, Osobiste..."
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:focus:ring-blue-400 dark:focus:border-blue-400">
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300">Opis (opcjonalnie)</label>
        <textarea name="description" id="groupDescription" rows="2"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:focus:ring-blue-400 dark:focus:border-blue-400"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" onclick="closeModal('groupModal')" class="px-4 py-2 text-gray-600 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-200">Anuluj</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Zapisz</button>
      </div>
    </form>
  </div>
</div>

<script>
function openModal(id) {
  document.getElementById(id).classList.add('active');
  document.getElementById('groupModalTitle').textContent = 'Nowa grupa';
  document.getElementById('groupMethod').value = 'POST';
  document.getElementById('groupForm').action = '/groups';
  document.getElementById('groupName').value = '';
  document.getElementById('groupDescription').value = '';
  document.getElementById('groupCategory').value = '';
}

function editGroup(id, name, desc, cat) {
  document.getElementById('groupModal').classList.add('active');
  document.getElementById('groupModalTitle').textContent = 'Edytuj grupę';
  document.getElementById('groupMethod').value = 'PUT';
  document.getElementById('groupForm').action = '/groups/' + id;
  document.getElementById('groupName').value = name;
  document.getElementById('groupDescription').value = desc;
  document.getElementById('groupCategory').value = cat || '';
}

function closeModal(id) {
  document.getElementById(id).classList.remove('active');
}

function toggleCategory(catId) {
  var grid = document.getElementById(catId);
  var arrow = document.getElementById(catId + '-arrow');
  if (!grid || !arrow) return;
  
  if (grid.style.display === 'none') {
    grid.style.display = '';
    arrow.style.transform = 'rotate(0deg)';
    localStorage.setItem(catId, 'open');
  } else {
    grid.style.display = 'none';
    arrow.style.transform = 'rotate(-90deg)';
    localStorage.setItem(catId, 'closed');
  }
}

// Restore category state from localStorage
document.addEventListener('DOMContentLoaded', function() {
  // Restore collapse state
  document.querySelectorAll('[id$="-arrow"]').forEach(function(arrow) {
    var catId = arrow.id.replace('-arrow', '');
    var state = localStorage.getItem(catId);
    if (state === 'closed') {
      var grid = document.getElementById(catId);
      if (grid) grid.style.display = 'none';
      arrow.style.transform = 'rotate(-90deg)';
    }
  });
  
  // Restore category order
  var savedOrder = localStorage.getItem('categoryOrder');
  if (savedOrder) {
    var order = JSON.parse(savedOrder);
    var container = document.querySelector('.category-section'); 
    if (!container) return;
    var parent = container.parentElement;
    var sections = Array.from(parent.querySelectorAll('.category-section'));
    // Sort sections by saved order
    sections.sort(function(a, b) {
      var aIdx = order.indexOf(a.getAttribute('data-category'));
      var bIdx = order.indexOf(b.getAttribute('data-category'));
      if (aIdx === -1) return 1;
      if (bIdx === -1) return -1;
      return aIdx - bIdx;
    });
    // Move DOM nodes
    sections.forEach(function(s) { parent.appendChild(s); });
  }
});

// --- Category drag & drop ---
var draggedCategory = null;

function onCategoryDragStart(e) {
  draggedCategory = e.target.closest('.category-section');
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', '');
  draggedCategory.style.opacity = '0.5';
}

function onCategoryDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  var section = e.target.closest('.category-section');
  if (section) section.classList.add('drag-over');
}

function onCategoryDragLeave(e) {
  var section = e.target.closest('.category-section');
  if (section) section.classList.remove('drag-over');
}

function onCategoryDrop(e) {
  e.preventDefault();
  document.querySelectorAll('.category-section').forEach(function(s) { 
    s.classList.remove('drag-over');
  });
  
  var target = e.target.closest('.category-section');
  if (!target || !draggedCategory || target === draggedCategory) {
    if (draggedCategory) draggedCategory.style.opacity = '';
    draggedCategory = null;
    return;
  }
  
  // Insert before target
  target.parentElement.insertBefore(draggedCategory, target);
  draggedCategory.style.opacity = '';
  
  // Save order
  var sections = Array.from(document.querySelectorAll('.category-section'));
  var order = sections.map(function(s) { return s.getAttribute('data-category'); });
  localStorage.setItem('categoryOrder', JSON.stringify(order));
  
  draggedCategory = null;
}

// Zamknij modal po kliknięciu w tło
document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', (e) => {
    if (e.target === m) m.classList.remove('active');
  });
});
</script>
