<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-6 inline-flex items-center gap-2"><svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg><%= t('admin.title') %></h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 text-red-600 dark:text-red-400 px-4 py-3 rounded-lg mb-4 text-sm"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 text-green-600 dark:text-green-400 px-4 py-3 rounded-lg mb-4 text-sm"><%= success %></div>
  <% } %>
  <% if (typeof resetPassword !== 'undefined' && resetPassword) { %>
    <div class="bg-yellow-50 dark:bg-yellow-900/30 border border-yellow-200 dark:border-yellow-700 text-yellow-700 dark:text-yellow-400 px-4 py-3 rounded-lg mb-4 text-sm">
      <svg class="w-4 h-4 inline mr-1 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/></svg><%= t('admin.reset_password_for', { id: resetUser }) %> <code class="font-bold bg-yellow-100 dark:bg-yellow-800 px-2 py-0.5 rounded"><%= resetPassword %></code>
      <br><span class="text-xs"><%= t('admin.reset_password_hint') %></span>
    </div>
  <% } %>

  <!-- Stats -->
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <div class="text-3xl font-bold text-blue-600 dark:text-blue-400"><%= stats.totalUsers %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('admin.stat_users') %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400"><%= stats.totalGroups %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('admin.stat_groups') %></div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <div class="text-3xl font-bold text-purple-600 dark:text-purple-400"><%= stats.totalItems %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= t('admin.stat_items') %></div>
    </div>
  </div>

  <!-- Daily registrations -->
  <% if (stats.dailyRegistrations.length > 0) { %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3"><%= t('admin.registrations') %></h2>
    <div class="space-y-1">
      <% stats.dailyRegistrations.forEach(day => { %>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400"><%= day.day %></span>
          <span class="font-medium <%= day.count > 5 ? 'text-red-500' : 'text-gray-700 dark:text-gray-300' %>"><%= day.count %></span>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Recent users -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3"><%= t('admin.recent_accounts') %></h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-100 dark:border-gray-700">
            <th class="pb-2 font-medium"><%= t('admin.col_id') %></th>
            <th class="pb-2 font-medium"><%= t('admin.col_username') %></th>
            <th class="pb-2 font-medium"><%= t('admin.col_created') %></th>
            <th class="pb-2 font-medium text-right"><%= t('admin.col_actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% stats.recentUsers.forEach(u => { %>
            <tr class="border-b border-gray-50 dark:border-gray-700/50">
              <td class="py-2 text-gray-400 dark:text-gray-500"><%= u.id %></td>
              <td class="py-2 text-gray-800 dark:text-gray-200"><%= u.username %></td>
              <td class="py-2 text-gray-500 dark:text-gray-400 text-xs"><%= new Date(u.created_at).toLocaleString(locale) %></td>
              <td class="py-2 text-right">
                <form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="inline" data-confirm="<%= t('admin.reset_confirm', { username: u.username }) %>">
                  <button class="text-xs text-yellow-600 dark:text-yellow-400 hover:underline mr-2 inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/></svg><%= t('admin.reset_password') %></button>
                </form>
                <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline" data-confirm="<%= t('admin.delete_confirm', { username: u.username }) %>">
                  <button class="text-xs text-red-500 dark:text-red-400 hover:underline inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg><%= t('common.delete') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
