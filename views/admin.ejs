<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-6">🛡️ Panel administratora</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 text-red-600 dark:text-red-400 px-4 py-3 rounded-lg mb-4 text-sm"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 text-green-600 dark:text-green-400 px-4 py-3 rounded-lg mb-4 text-sm"><%= success %></div>
  <% } %>
  <% if (typeof resetPassword !== 'undefined' && resetPassword) { %>
    <div class="bg-yellow-50 dark:bg-yellow-900/30 border border-yellow-200 dark:border-yellow-700 text-yellow-700 dark:text-yellow-400 px-4 py-3 rounded-lg mb-4 text-sm">
      🔑 Nowe hasło dla użytkownika #<%= resetUser %>: <code class="font-bold bg-yellow-100 dark:bg-yellow-800 px-2 py-0.5 rounded"><%= resetPassword %></code>
      <br><span class="text-xs">Skopiuj je — nie będzie ponownie widoczne.</span>
    </div>
  <% } %>

  <!-- Stats -->
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <div class="text-3xl font-bold text-blue-600 dark:text-blue-400"><%= stats.totalUsers %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Użytkowników</div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <div class="text-3xl font-bold text-green-600 dark:text-green-400"><%= stats.totalGroups %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Grup</div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <div class="text-3xl font-bold text-purple-600 dark:text-purple-400"><%= stats.totalItems %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Zadań/notatek</div>
    </div>
  </div>

  <!-- Daily registrations -->
  <% if (stats.dailyRegistrations.length > 0) { %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 mb-6">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Rejestracje — ostatnie 7 dni</h2>
    <div class="space-y-1">
      <% stats.dailyRegistrations.forEach(day => { %>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500 dark:text-gray-400"><%= day.day %></span>
          <span class="font-medium <%= day.count > 5 ? 'text-red-500' : 'text-gray-700 dark:text-gray-300' %>"><%= day.count %></span>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Recent users -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Ostatnie konta</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-100 dark:border-gray-700">
            <th class="pb-2 font-medium">ID</th>
            <th class="pb-2 font-medium">Username</th>
            <th class="pb-2 font-medium">Utworzono</th>
            <th class="pb-2 font-medium text-right">Akcje</th>
          </tr>
        </thead>
        <tbody>
          <% stats.recentUsers.forEach(u => { %>
            <tr class="border-b border-gray-50 dark:border-gray-700/50">
              <td class="py-2 text-gray-400 dark:text-gray-500"><%= u.id %></td>
              <td class="py-2 text-gray-800 dark:text-gray-200"><%= u.username %></td>
              <td class="py-2 text-gray-500 dark:text-gray-400 text-xs"><%= new Date(u.created_at).toLocaleString('pl-PL') %></td>
              <td class="py-2 text-right">
                <form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="inline" data-confirm="Zresetować hasło użytkownika <%= u.username %>?')">
                  <button class="text-xs text-yellow-600 dark:text-yellow-400 hover:underline mr-2">🔑 Reset hasła</button>
                </form>
                <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline" data-confirm="USUNĄĆ użytkownika <%= u.username %> i wszystkie jego dane? Tej operacji nie można cofnąć!')">
                  <button class="text-xs text-red-500 dark:text-red-400 hover:underline">🗑️ Usuń</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
