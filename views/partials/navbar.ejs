<!-- partials/navbar.ejs - Breadcrumb dla stron grup -->
<div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
  <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Grupy</a>
  <% if (typeof group !== 'undefined' && group) { %>
    <span>/</span>
    <span class="text-gray-800 dark:text-gray-200 font-medium"><%= group.name %></span>
  <% } else { %>
    <span class="text-gray-400 dark:text-gray-500 ml-2">— UniTodo: aplikacja do zarządzania zadaniami, do pracy solo i w grupie</span>
  <% } %>
</div>
