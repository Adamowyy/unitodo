<!-- partials/navbar.ejs - Breadcrumb for the group pages -->
<div class="text-sm text-gray-500 mb-4">
  <% if (typeof group !== 'undefined' && group) { %>
    <div class="flex items-center gap-2">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400"><%= t('nav.groups') %></a>
      <span>/</span>
      <span class="text-gray-800 dark:text-gray-200 font-medium"><%= group.name %></span>
    </div>
  <% } else { %>
    <span class="text-gray-400 dark:text-gray-500"><%= t('app.tagline') %></span>
  <% } %>
</div>
