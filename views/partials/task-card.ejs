<!-- partials/task-card.ejs - Karta zadania z priorytetem i podzadaniami -->
<%
  const pLabel = ['', 'Brak', 'Niski', 'Średni', 'Wysoki'][task.priority] || '';
  const pBorder = ['', '', 'border-blue-200 dark:border-blue-800', 'border-orange-200 dark:border-orange-800', 'border-red-200 dark:border-red-800'][task.priority] || 'border-gray-200 dark:border-gray-700';
  const isDone = task.status === 'done' || task.is_completed;
  const taskData = JSON.stringify({id:task.id, title:task.title, content:task.content||'', priority:task.priority, status:task.status||'todo', due_date:task.due_date||'', assigned_to:task.assigned_to||''});
  const assignee = task.assigned_to && members ? members.find(m => m.id === task.assigned_to) : null;
%>
<div class="task-card bg-white dark:bg-gray-800 rounded-lg border <%= pBorder %> p-3 cursor-grab active:cursor-grabbing animate-slide <%= isDone ? 'opacity-60' : '' %>" 
     draggable="true" data-task-id="<%= task.id %>"
     ondragstart="onDragStart(event)"
     style="<%= task.priority >= 2 ? 'border-left-width:4px' : '' %>">
  
  <div class="flex justify-between items-start mb-1">
    <div class="flex items-center gap-1.5 flex-1 min-w-0">
      <span class="priority-badge p<%= task.priority %> shrink-0"></span>
      <span class="text-xs text-gray-400 dark:text-gray-500"><%= pLabel %></span>
      <% if (assignee) { %>
        <span class="text-xs px-1.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 font-medium ml-1">👤 <%= assignee.username %></span>
      <% } %>
    </div>
    <div class="flex gap-0.5 shrink-0">
      <% if (!isDone) { %>
        <button onclick="event.stopPropagation(); completeTask(<%= task.id %>)" draggable="false"
          class="text-gray-300 dark:text-gray-600 hover:text-green-600 dark:hover:text-green-400 p-0.5" title="Oznacz jako zrobione">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </button>
      <% } %>
      <button onclick="event.stopPropagation(); openTaskModal(<%= taskData %>)" 
        class="text-gray-300 dark:text-gray-600 hover:text-blue-600 dark:hover:text-blue-400 p-0.5" title="Edytuj">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </button>
      <form method="POST" action="/tasks/<%= task.id %>?_method=DELETE" data-confirm="Usunąć zadanie wraz z podzadaniami?" class="inline">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="text-gray-300 dark:text-gray-600 hover:text-red-600 dark:hover:text-red-400 p-0.5" title="Usuń">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </form>
    </div>
  </div>
  
  <h4 class="font-medium text-gray-800 dark:text-gray-200 text-sm mb-1"><%= task.title %></h4>
  <% if (task.content) { %>
    <p class="text-xs text-gray-500 dark:text-gray-400 mb-2 line-clamp-2"><%= task.content %></p>
  <% } %>

  <!-- Termin -->
  <% if (task.due_date) { 
    const dueDate = new Date(task.due_date);
    const isOverdue = dueDate < new Date() && task.status !== 'done' && !task.is_completed;
  %>
    <div class="text-xs mt-1 <%= isOverdue ? 'text-red-500 font-medium' : 'text-gray-400 dark:text-gray-500' %>">
      <% if (isOverdue) { %>⚠️ <% } %>📅 <%= dueDate.toLocaleDateString('pl-PL') %>
    </div>
  <% } %>

  <!-- Podzadania -->
  <% if (subtasks && subtasks.length > 0) { %>
    <div class="mt-2 space-y-1">
      <% subtasks.forEach(st => { %>
        <div class="subtask-item pl-3 flex items-start gap-2 py-0.5 group">
          <input type="checkbox" <%= st.is_completed ? 'checked' : '' %> 
            onclick="toggleSubtask(<%= st.id %>)" 
            class="mt-0.5 h-3.5 w-3.5 rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 focus:ring-blue-500 dark:focus:ring-blue-400 cursor-pointer">
          <span class="text-xs flex-1 <%= st.is_completed ? 'line-through text-gray-400 dark:text-gray-500' : 'text-gray-700 dark:text-gray-300' %>">
            <%= st.title %>
          </span>
          <button onclick="event.stopPropagation(); openSubtaskModal(event, <%= task.id %>, {id:<%= st.id %>, title:'<%= st.title.replace(/'/g, "\\\\'") %>'})" draggable="false"
            class="opacity-0 group-hover:opacity-100 text-gray-300 dark:text-gray-600 hover:text-blue-600 dark:hover:text-blue-400 p-0.5 shrink-0" title="Edytuj podzadanie">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </button>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Dodaj podzadanie -->
  <button onclick="openSubtaskModal(event, <%= task.id %>)" draggable="false"
    class="mt-2 text-xs text-gray-400 dark:text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-1">
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Dodaj podzadanie
  </button>

  <!-- Mobile move buttons -->
  <% if (!isDone) { %>
  <div class="mt-2 flex gap-1 border-t border-gray-100 dark:border-gray-700 pt-2 md:hidden">
    <% if (task.status === 'todo') { %>
      <button onclick="event.stopPropagation(); moveTask(<%= task.id %>, 'in_progress')" draggable="false"
        class="flex-1 text-xs bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-400 hover:bg-yellow-100 dark:hover:bg-yellow-900/40 px-2 py-1 rounded transition">
        → W trakcie
      </button>
    <% } else if (task.status === 'in_progress') { %>
      <button onclick="event.stopPropagation(); moveTask(<%= task.id %>, 'todo')" draggable="false"
        class="flex-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-600 px-2 py-1 rounded transition">
        ← Cofnij
      </button>
      <button onclick="event.stopPropagation(); moveTask(<%= task.id %>, 'done')" draggable="false"
        class="flex-1 text-xs bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 hover:bg-green-100 dark:hover:bg-green-900/40 px-2 py-1 rounded transition">
        ✓ Zrobione
      </button>
    <% } %>
  </div>
  <% } else { %>
  <div class="mt-2 border-t border-gray-100 dark:border-gray-700 pt-2 md:hidden">
    <button onclick="event.stopPropagation(); moveTask(<%= task.id %>, 'todo')" draggable="false"
      class="w-full text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-600 px-2 py-1 rounded transition">
      ↩️ Przywróć
    </button>
  </div>
  <% } %>
</div>
