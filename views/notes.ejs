<div class="flex justify-between items-center mb-6">
  <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">📝 Notatki</h2>
  <button onclick="openNoteModal()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm font-medium">
    + Nowa notatka
  </button>
</div>

<% if (typeof query !== 'undefined' && query.trim()) { %>
  <div class="mb-4 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
    <span>🔍 Wyniki dla: <strong><%= query %></strong></span>
    <a href="?" class="text-blue-600 dark:text-blue-400 hover:underline ml-2">Wyczyść</a>
  </div>
<% } %>

<% if (notes.length === 0) { %>
  <div class="text-center py-12 text-gray-400 dark:text-gray-500">
    <div class="text-5xl mb-3">📄</div>
    <p>Brak notatek w tej grupie</p>
    <p class="text-sm mt-1">Kliknij "Nowa notatka", aby dodać pierwszą</p>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
    <% notes.forEach(note => { 
      const noteComments = typeof commentsByNote !== 'undefined' ? (commentsByNote[note.id] || []) : [];
    %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow dark:bg-gray-800 dark:border-gray-700 dark:hover:shadow-gray-900/30 flex flex-col">
        <div class="flex justify-between items-start mb-2">
          <h3 class="font-semibold text-gray-800 text-lg dark:text-gray-200"><%= note.title %></h3>
          <div class="flex gap-1">
            <button onclick="editNote(<%= note.id %>, '<%= note.title.replace(/'/g, "\\'") %>', <%= JSON.stringify(note.content || '') %>)" class="text-gray-400 hover:text-blue-600 p-1 dark:text-gray-500 dark:hover:text-blue-400" title="Edytuj">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
            </button>
            <form method="POST" action="/notes/<%= note.id %>?_method=DELETE" data-confirm="Usunąć notatkę?" class="inline">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="text-gray-400 hover:text-red-600 p-1 dark:text-gray-500 dark:hover:text-red-400" title="Usuń">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </form>
          </div>
        </div>
        <% if (note.content) { %>
          <p class="text-gray-600 text-sm whitespace-pre-wrap dark:text-gray-300 notes-content"><%= note.content %></p>
        <% } %>
        <div class="flex items-center gap-2 text-xs text-gray-400 mt-3 dark:text-gray-500">
          <% if (note.author) { %>
            <span class="font-medium text-gray-500 dark:text-gray-400">👤 <%= note.author %></span>
            <span>·</span>
          <% } %>
          <span><%= new Date(note.created_at).toLocaleString('pl-PL', { timeZone: 'Europe/Warsaw' }) %></span>
        </div>

        <!-- Comments section -->
        <div class="mt-auto pt-3 border-t border-gray-100 dark:border-gray-700">
          <% noteComments.forEach(c => { %>
            <div class="flex gap-2 mb-2 text-sm group">
              <span class="text-xs font-medium text-gray-500 dark:text-gray-400 shrink-0"><%= c.author || '?' %></span>
              <span class="text-gray-600 dark:text-gray-300 flex-1 comment-text"><%= c.content %></span>
              <form method="POST" action="/comments/<%= c.id %>?_method=DELETE" data-confirm="Usunąć komentarz?" class="inline shrink-0">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="text-gray-400 dark:text-gray-500 hover:text-red-500 text-xs px-1" title="Usuń komentarz">&times;</button>
              </form>
            </div>
          <% }) %>
          <form method="POST" action="/notes/<%= note.id %>/comments" class="flex gap-2 mt-2">
            <input type="text" name="content" placeholder="Dodaj komentarz..." maxlength="500"
              class="flex-1 text-xs px-2 py-1.5 border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-700 dark:text-gray-300 focus:ring-1 focus:ring-blue-500 outline-none">
            <button type="submit" class="text-xs text-blue-600 dark:text-blue-400 hover:underline shrink-0">Wyślij</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- Modal dodawania/edycji notatki -->
<div id="noteModal" class="modal-overlay">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold" id="noteModalTitle">Nowa notatka</h3>
      <button onclick="closeModal('noteModal')" class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-400">&times;</button>
    </div>
    <form id="noteForm" method="POST">
      <input type="hidden" name="_method" id="noteMethod" value="POST">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300">Tytuł</label>
        <input type="text" name="title" id="noteTitle" required
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:focus:ring-blue-400">
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1 dark:text-gray-300">Treść</label>
        <textarea name="content" id="noteContent" rows="5"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:focus:ring-blue-400"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" onclick="closeModal('noteModal')" class="px-4 py-2 text-gray-600 dark:text-gray-300">Anuluj</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Zapisz</button>
      </div>
    </form>
  </div>
</div>

<script>
function openNoteModal() {
  document.getElementById('noteModal').classList.add('active');
  document.getElementById('noteModalTitle').textContent = 'Nowa notatka';
  document.getElementById('noteMethod').value = 'POST';
  document.getElementById('noteForm').action = '/groups/<%= group.id %>/notes';
  document.getElementById('noteTitle').value = '';
  document.getElementById('noteContent').value = '';
}

function editNote(id, title, content) {
  document.getElementById('noteModal').classList.add('active');
  document.getElementById('noteModalTitle').textContent = 'Edytuj notatkę';
  document.getElementById('noteMethod').value = 'PUT';
  document.getElementById('noteForm').action = '/notes/' + id;
  document.getElementById('noteTitle').value = title;
  document.getElementById('noteContent').value = content;
}
</script>
