<!-- views/tasks.ejs: kanban board with priorities and subtasks -->
<div class="mb-6">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">✅ <%= t('tasks.title') %></h2>
    <button onclick="openTaskModal(null)" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm font-medium">
      + <%= t('tasks.new') %>
    </button>
  </div>

  <% if (typeof query !== 'undefined' && query.trim()) { %>
    <div class="mb-4 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <span>🔍 <%= t('common.search_label') %>: <strong><%= query %></strong></span>
      <a href="?" class="text-blue-600 dark:text-blue-400 hover:underline ml-2"><%= t('common.clear') %></a>
    </div>
  <% } %>

  <!-- Filter bar -->
  <div class="flex flex-wrap gap-3 mb-4 items-center">
    <!-- Sort -->
    <div class="flex items-center gap-1.5">
      <label class="text-xs text-gray-500 dark:text-gray-400"><%= t('tasks.sort') %></label>
      <select name="sort" onchange="applyFilters(this.value, null, null)"
        class="text-xs px-2 py-1.5 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300">
        <option value="created_desc" <%= sort === 'created_desc' ? 'selected' : '' %>><%= t('tasks.sort_created_desc') %></option>
        <option value="created_asc" <%= sort === 'created_asc' ? 'selected' : '' %>><%= t('tasks.sort_created_asc') %></option>
        <option value="priority_desc" <%= sort === 'priority_desc' ? 'selected' : '' %>><%= t('tasks.sort_priority_desc') %></option>
        <option value="priority_asc" <%= sort === 'priority_asc' ? 'selected' : '' %>><%= t('tasks.sort_priority_asc') %></option>
        <option value="due_asc" <%= sort === 'due_asc' ? 'selected' : '' %>><%= t('tasks.sort_due_asc') %></option>
        <option value="due_desc" <%= sort === 'due_desc' ? 'selected' : '' %>><%= t('tasks.sort_due_desc') %></option>
        <option value="title_asc" <%= sort === 'title_asc' ? 'selected' : '' %>><%= t('tasks.sort_title_asc') %></option>
      </select>
    </div>

    <!-- Priority -->
    <div class="flex items-center gap-1.5">
      <label class="text-xs text-gray-500 dark:text-gray-400"><%= t('tasks.filter_priority') %></label>
      <select name="filter_priority" onchange="applyFilters(null, this.value, null)"
        class="text-xs px-2 py-1.5 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300">
        <option value="0" <%= !filter_priority || filter_priority == 0 ? 'selected' : '' %>><%= t('tasks.filter_all') %></option>
        <option value="2" <%= filter_priority == 2 ? 'selected' : '' %>><%= t('tasks.priority_low') %></option>
        <option value="3" <%= filter_priority == 3 ? 'selected' : '' %>><%= t('tasks.priority_medium') %></option>
        <option value="4" <%= filter_priority == 4 ? 'selected' : '' %>><%= t('tasks.priority_high') %></option>
      </select>
    </div>

    <!-- Status -->
    <div class="flex items-center gap-1.5">
      <label class="text-xs text-gray-500 dark:text-gray-400"><%= t('tasks.filter_status') %></label>
      <select name="filter_status" onchange="applyFilters(null, null, this.value)"
        class="text-xs px-2 py-1.5 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300">
        <option value="" <%= !filter_status ? 'selected' : '' %>><%= t('tasks.filter_all') %></option>
        <option value="todo" <%= filter_status === 'todo' ? 'selected' : '' %>><%= t('tasks.status_todo') %></option>
        <option value="in_progress" <%= filter_status === 'in_progress' ? 'selected' : '' %>><%= t('tasks.status_in_progress') %></option>
        <option value="done" <%= filter_status === 'done' ? 'selected' : '' %>><%= t('tasks.status_done') %></option>
      </select>
    </div>

    <!-- Hide done -->
    <label class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 cursor-pointer select-none">
      <input type="checkbox" onchange="toggleHideDone(this.checked)" <%= hideDone ? 'checked' : '' %>
        class="rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 focus:ring-blue-500 dark:focus:ring-blue-400">
      <%= t('tasks.hide_done') %>
    </label>

    <% if (sort !== 'created_desc' || filter_priority > 0 || filter_status || hideDone) { %>
      <a href="/groups/<%= group.id %>/tasks" class="text-xs text-blue-600 dark:text-blue-400 hover:underline"><%= t('tasks.clear_filters') %></a>
    <% } %>
  </div>

  <!-- Kanban columns -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- TODO -->
    <% if (!filter_status || filter_status === 'todo') { %>
      <% const todoColSpan = filter_status ? 'md:col-span-3' : ''; %>
    <div class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-4 <%= todoColSpan %>">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-3 h-3 rounded-full bg-blue-500"></span>
        <h3 class="font-semibold text-gray-700 dark:text-gray-300"><%= t('tasks.status_todo') %></h3>
        <span class="text-xs bg-gray-200 dark:bg-gray-600 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded-full"><%= todoTasks.length %></span>
      </div>
      <div class="kanban-column space-y-3" data-status="todo"
        ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
        <% todoTasks.forEach(task => { %>
          <%- include('partials/task-card', { task, subtasks: subtasksByParent[task.id] || [], group, hideDone, members }) %>
        <% }) %>
        <% if (todoTasks.length === 0) { %>
          <div class="text-center py-8 text-gray-400 dark:text-gray-500 text-sm border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-lg">
          <span class="hidden md:inline"><%= t('tasks.drop_here') %></span>
          <span class="md:hidden"><%= t('tasks.none_in_column') %></span>
          </div>
          <% } %>
          </div>
          </div>
          <% } %>

          <!-- IN PROGRESS -->
          <% if (!filter_status || filter_status === 'in_progress') { %>
          <% const inProgressColSpan = filter_status ? 'md:col-span-3' : ''; %>
          <div class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-4 <%= inProgressColSpan %>">
          <div class="flex items-center gap-2 mb-4">
          <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
          <h3 class="font-semibold text-gray-700 dark:text-gray-300"><%= t('tasks.status_in_progress') %></h3>
          <span class="text-xs bg-gray-200 dark:bg-gray-600 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded-full"><%= inProgressTasks.length %></span>
          </div>
          <div class="kanban-column space-y-3" data-status="in_progress"
          ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
          <% inProgressTasks.forEach(task => { %>
          <%- include('partials/task-card', { task, subtasks: subtasksByParent[task.id] || [], group, hideDone, members }) %>
          <% }) %>
          <% if (inProgressTasks.length === 0) { %>
          <div class="text-center py-8 text-gray-400 dark:text-gray-500 text-sm border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-lg">
          <span class="hidden md:inline"><%= t('tasks.drop_here') %></span>
          <span class="md:hidden"><%= t('tasks.none_in_column') %></span>
          </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- DONE -->
    <% if (!filter_status || filter_status === 'done') { %>
      <% if (!hideDone) { %>
      <% const doneColSpan = filter_status ? 'md:col-span-3' : ''; %>
      <% const CHUNK = 10; %>
    <div class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-4 <%= doneColSpan %>">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-3 h-3 rounded-full bg-green-500"></span>
        <h3 class="font-semibold text-gray-700 dark:text-gray-300"><%= t('tasks.status_done') %></h3>
        <span class="text-xs bg-gray-200 dark:bg-gray-600 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded-full"><%= doneTasks.length %></span>
      </div>
      <div class="space-y-3" data-status="done"
        ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
        <div class="kanban-column space-y-3">
        <% let hiddenChunks = 0; %>
        <% doneTasks.forEach((task, i) => { %>
          <%- include('partials/task-card', { task, subtasks: subtasksByParent[task.id] || [], group, hideDone, members }) %>
          <% if (i === 2 && doneTasks.length > 3) { %>
            </div><div id="done-hidden" class="hidden"><div class="done-chunk kanban-column space-y-3"><% hiddenChunks = 1; %>
          <% } else if (i > 3 && (i - 3) % CHUNK === 0 && i !== 3 && doneTasks.length > 3) { %>
            </div><div class="done-chunk hidden kanban-column space-y-3"><% hiddenChunks++; %>
          <% } %>
        <% }) %>
        <% if (doneTasks.length === 0) { %>
          <div class="text-center py-8 text-gray-400 dark:text-gray-500 text-sm border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-lg">
            <span class="hidden md:inline"><%= t('tasks.drop_here') %></span>
            <span class="md:hidden"><%= t('tasks.none_in_column') %></span>
          </div>
        <% } %>
        </div>
      </div>
      <% if (doneTasks.length > 3) { %>
        <% const remaining = doneTasks.length - 3; %>
        <% const nextBatch = Math.min(CHUNK, remaining); %>
        <button onclick="revealDoneChunk(this)" data-remaining="<%= remaining %>" data-total="<%= remaining %>" data-chunk="<%= CHUNK %>" class="mt-3 w-full text-xs text-gray-400 dark:text-gray-500 hover:text-blue-600 dark:hover:text-blue-400 transition py-1.5 border border-dashed border-gray-200 dark:border-gray-700 rounded-lg">
          <%= t('tasks.show_next', { count: nextBatch, remaining: remaining }) %>
        </button>
      <% } %>
    </div>
    <% } %>
    <% } %>
  </div>
</div>

<!-- Add/edit task modal -->
<div id="taskModal" class="modal-overlay">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold" id="taskModalTitle"><%= t('tasks.new') %></h3>
      <button onclick="closeModal('taskModal')" class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400">&times;</button>
    </div>
    <form id="taskForm" method="POST">
      <input type="hidden" name="_method" id="taskMethod" value="POST">
      <input type="hidden" name="status" id="taskStatus" value="todo">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"><%= t('tasks.field_title') %></label>
        <input type="text" name="title" id="taskTitle" required
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200">
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"><%= t('tasks.field_description') %></label>
        <textarea name="content" id="taskContent" rows="3"
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200"></textarea>
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"><%= t('tasks.field_priority') %></label>
        <select name="priority" id="taskPriority"
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200">
          <option value="1"><%= t('tasks.priority_none') %></option>
          <option value="2"><%= t('tasks.priority_low') %></option>
          <option value="3"><%= t('tasks.priority_medium') %></option>
          <option value="4"><%= t('tasks.priority_high') %></option>
        </select>
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"><%= t('tasks.field_due') %></label>
        <input type="date" name="due_date" id="taskDueDate"
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200">
      </div>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"><%= t('tasks.field_assignee') %></label>
        <select name="assigned_to" id="taskAssignedTo"
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200">
          <option value=""><%= t('tasks.assignee_none') %></option>
          <% if (typeof members !== 'undefined' && members) { %>
            <% members.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.username %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" onclick="closeModal('taskModal')" class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= t('common.cancel') %></button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"><%= t('common.save') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Add/edit subtask modal -->
<div id="subtaskModal" class="modal-overlay">
  <div class="modal-content">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold dark:text-gray-200" id="subtaskModalTitle"><%= t('tasks.subtask_new') %></h3>
      <button onclick="closeModal('subtaskModal')" class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400">&times;</button>
    </div>
    <form method="POST" id="subtaskForm">
      <input type="hidden" name="_method" id="subtaskMethod" value="POST">
      <input type="hidden" name="parent_id" id="subtaskParentId">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"><%= t('tasks.subtask_title_label') %></label>
        <input type="text" name="title" id="subtaskTitle" required
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 outline-none dark:bg-gray-700 dark:text-gray-200">
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" onclick="closeModal('subtaskModal')" class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= t('common.cancel') %></button>
        <button type="submit" id="subtaskSubmitBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"><%= t('common.add') %></button>
      </div>
    </form>
  </div>
</div>

<script>
function openTaskModal(taskData) {
  const modal = document.getElementById('taskModal');
  modal.classList.add('active');
  if (taskData) {
    document.getElementById('taskModalTitle').textContent = t('task_edit');
    document.getElementById('taskMethod').value = 'PUT';
    document.getElementById('taskForm').action = '/tasks/' + taskData.id;
    document.getElementById('taskTitle').value = taskData.title;
    document.getElementById('taskContent').value = taskData.content || '';
    document.getElementById('taskPriority').value = taskData.priority;
    document.getElementById('taskStatus').value = taskData.status || 'todo';
    document.getElementById('taskDueDate').value = taskData.due_date || '';
    document.getElementById('taskAssignedTo').value = taskData.assigned_to || '';
  } else {
    document.getElementById('taskModalTitle').textContent = t('task_new');
    document.getElementById('taskMethod').value = 'POST';
    document.getElementById('taskForm').action = '/groups/<%= group.id %>/tasks';
    document.getElementById('taskTitle').value = '';
    document.getElementById('taskContent').value = '';
    document.getElementById('taskPriority').value = '1';
    document.getElementById('taskStatus').value = 'todo';
    document.getElementById('taskDueDate').value = '';
    document.getElementById('taskAssignedTo').value = '';
  }
}

function openSubtaskModal(e, taskId, subtaskData) {
  e.stopPropagation();
  const modal = document.getElementById('subtaskModal');
  modal.classList.add('active');
  if (subtaskData) {
    // Edit mode
    document.getElementById('subtaskModalTitle').textContent = t('subtask_edit');
    document.getElementById('subtaskMethod').value = 'PUT';
    document.getElementById('subtaskForm').action = '/subtasks/' + subtaskData.id;
    document.getElementById('subtaskTitle').value = subtaskData.title;
    document.getElementById('subtaskSubmitBtn').textContent = t('save');
  } else {
    // Create mode
    document.getElementById('subtaskModalTitle').textContent = t('subtask_new');
    document.getElementById('subtaskMethod').value = 'POST';
    document.getElementById('subtaskForm').action = '/tasks/' + taskId + '/subtasks';
    document.getElementById('subtaskTitle').value = '';
    document.getElementById('subtaskSubmitBtn').textContent = t('add');
  }
  document.getElementById('subtaskParentId').value = taskId;
  document.getElementById('subtaskTitle').focus();
}

function toggleSubtask(id) {
  fetch('/tasks/' + id + '/toggle', { method: 'PUT' })
    .then(r => r.json())
    .then(data => { if (data.success) location.reload(); });
}

function completeTask(taskId) {
  fetch('/tasks/' + taskId + '/move', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: 'done' })
  }).then(r => r.json())
    .then(data => { if (data.success) location.reload(); })
    .catch(() => location.reload());
}

// Drag & Drop
let draggedTaskId = null;

function onDragStart(e) {
  draggedTaskId = e.target.closest('[data-task-id]').dataset.taskId;
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', draggedTaskId);
}

function onDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  e.currentTarget.classList.add('drag-over');
}

function onDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}

function onDrop(e) {
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  const taskId = e.dataTransfer.getData('text/plain');
  const newStatus = e.currentTarget.dataset.status;
  
  if (taskId && newStatus) {
    fetch('/tasks/' + taskId + '/move', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    }).then(r => r.json())
      .then(data => {
        if (data.success) location.reload();
      });
  }
}

function applyFilters(sort, priority, status) {
  const params = new URLSearchParams(window.location.search);
  if (sort !== null) params.set('sort', sort);
  if (priority !== null) {
    if (priority === '0') params.delete('filter_priority');
    else params.set('filter_priority', priority);
  }
  if (status !== null) {
    if (status === '') params.delete('filter_status');
    else params.set('filter_status', status);
  }
  // Preserve hide_done from checkbox
  const hideDone = document.querySelector('#hideDoneCheck')?.checked;
  if (hideDone) params.set('hide_done', '1');
  else params.delete('hide_done');
  saveFilters(params);
  window.location.search = params.toString();
}

function toggleHideDone(checked) {
  const params = new URLSearchParams(window.location.search);
  if (checked) params.set('hide_done', '1');
  else params.delete('hide_done');
  saveFilters(params);
  window.location.search = params.toString();
}

function saveFilters(params) {
  if (!params) params = new URLSearchParams(window.location.search);
  ['sort', 'filter_priority', 'filter_status'].forEach(k => {
    if (params.has(k)) localStorage.setItem('tasks_' + k, params.get(k));
    else localStorage.removeItem('tasks_' + k);
  });
  if (params.has('hide_done')) localStorage.setItem('tasks_hide_done', '1');
  else localStorage.removeItem('tasks_hide_done');
}

// On page load: restore filters from localStorage if URL has no params
(function() {
  // Give the hide_done checkbox an ID for easy access
  const cb = document.querySelector('input[type=checkbox][onchange*=\"toggleHideDone\"]');
  if (cb) cb.id = 'hideDoneCheck';

  if (window.location.search) {
    // URL has params: save to localStorage
    saveFilters();
  } else {
    // No URL params: check localStorage
    const params = new URLSearchParams();
    ['sort', 'filter_priority', 'filter_status'].forEach(k => {
      const v = localStorage.getItem('tasks_' + k);
      if (v && v !== '' && v !== '0' && v !== 'created_desc') params.set(k, v);
    });
    if (localStorage.getItem('tasks_hide_done') === '1') params.set('hide_done', '1');
    if (params.toString()) {
      window.location.search = params.toString();
    }
  }
})();
</script>

<script>
function revealDoneChunk(btn) {
  var container = document.getElementById('done-hidden');
  if (!container) return;

  var remaining = parseInt(btn.dataset.remaining) || 0;
  var chunkSize = parseInt(btn.dataset.chunk) || 10;

  // First click: reveal the hidden container
  if (container.classList.contains('hidden')) {
    container.classList.remove('hidden');
    // First chunk inside is already visible, remaining decreases by chunkSize
    remaining -= chunkSize;
  } else {
    // Find next hidden chunk
    var nextChunk = container.querySelector('.done-chunk.hidden');
    if (nextChunk) {
      nextChunk.classList.remove('hidden');
      remaining -= chunkSize;
    }
  }

  btn.dataset.remaining = remaining;

  if (remaining <= 0) {
    btn.textContent = t('hide');
    btn.onclick = function() { collapseDone(btn); };
  } else {
    var next = Math.min(chunkSize, remaining);
    btn.textContent = t('show_next', { count: next, remaining: remaining });
  }
}

function collapseDone(btn) {
  var container = document.getElementById('done-hidden');
  if (!container) return;
  container.classList.add('hidden');
  // Re-hide all chunks except first
  var allChunks = container.querySelectorAll('.done-chunk');
  allChunks.forEach(function(c, i) {
    if (i > 0) c.classList.add('hidden');
  });
  var total = parseInt(btn.dataset.total) || parseInt(btn.dataset.chunk) || 10;
  var chunkSize = parseInt(btn.dataset.chunk) || 10;
  btn.dataset.remaining = total;
  btn.textContent = t('show_next', { count: Math.min(chunkSize, total), remaining: total });
  btn.onclick = function() { revealDoneChunk(btn); };
}
</script>
